# start-dev = playground defaults. start = production mode.
KEYCLOAK_START_COMMAND=start-dev

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Required/important for production mode.
KC_HOSTNAME_STRICT=false

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# request = ask for client cert, but allow no cert. required = hard mTLS.
KC_HTTPS_CLIENT_AUTH=request
KC_HTTPS_TRUST_STORE_PASSWORD=changeit

# keycloak-config-cli uses client_credentials + client secret.
# HTTPS is still verified with the local server CA truststore.
KEYCLOAK_CONFIG_CLI_LOGIN_REALM=master
KEYCLOAK_CONFIG_CLI_CLIENT_ID=keycloak-config-cli
KEYCLOAK_CONFIG_CLI_CLIENT_SECRET=changeit
KEYCLOAK_CONFIG_CLI_TRUSTSTORE_PASSWORD=changeit
